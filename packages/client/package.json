{
  "name": "@synixir/client",
  "version": "0.1.0",
  "description": "Synixir room synchronization, awareness, durable save status, and recovery for Yjs applications",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "pretest": "npm run build"
  },
  "dependencies": {
    "phoenix": "1.8.13",
    "y-phoenix-channel": "0.3.0",
    "y-protocols": "1.0.7"
  },
  "peerDependencies": {
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "yjs": "13.6.32"
  }
}
