# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
synixir-*.tar

# JavaScript workspaces and local package checks.
node_modules/
*.tgz

# Local staging credentials, certificates, backups and reports.
/.local/
__pycache__/

# TypeScript and Next.js build output.
/packages/client/dist/
/examples/collaboration/.next/
/examples/collaboration/.next-browser-test/
/examples/collaboration/.next-build-check/
/examples/collaboration/out/
*.tsbuildinfo
/examples/collaboration/next-env.d.ts

# Fonts copied from the installed Excalidraw package before dev/build.
/examples/collaboration/public/excalidraw-assets/
